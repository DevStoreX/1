# ---- Forja3D: configuración (todo es opcional; también se puede configurar desde la interfaz) ----

# Proveedor de IA: anthropic | ollama | openai-compatible
FORJA_PROVIDER=anthropic
# Modelo (claude-opus-5, claude-sonnet-5, claude-haiku-4-5, qwen3:8b...)
FORJA_MODEL=claude-opus-5
# Clave de https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# IA gratis en tu computadora con Ollama
OLLAMA_URL=http://localhost:11434

# Cualquier proveedor compatible con /chat/completions (LM Studio, OpenRouter, DeepSeek, Groq...)
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Figuras orgánicas con IA (TRELLIS / Hunyuan3D): https://fal.ai/dashboard/keys
FAL_KEY=
# O tu propio servidor Hunyuan3D-2 (api_server.py) si tienes GPU
HUNYUAN3D_URL=

# Búsqueda de modelos en Thingiverse (https://www.thingiverse.com/developers)
THINGIVERSE_TOKEN=

# Detector de fallos gratuito Obico (ml_api auto-hospedado)
OBICO_ML_URL=
OBICO_ML_TOKEN=

# Moneda para precios (USD, COP, MXN, ARS, EUR, PEN, CLP...)
FORJA_CURRENCY=USD

# ---- Servidor ----
PORT=8787
# 127.0.0.1 = solo este equipo. 0.0.0.0 = toda tu red (¡define FORJA_TOKEN!)
HOST=127.0.0.1
# Token para proteger la API y el MCP cuando escuchas en la red
FORJA_TOKEN=
# Dirección pública (para los enlaces del MCP)
FORJA_PUBLIC_URL=
# Carpeta de datos (modelos, impresoras, conversaciones). Por defecto ~/.forja3d
FORJA_DATA_DIR=

# ---- Opcional ----
# OpenSCAD nativo en lugar de WebAssembly
OPENSCAD_BIN=
# Laminador por línea de comandos (PrusaSlicer / SuperSlicer) y su perfil .ini
FORJA_SLICER_BIN=
FORJA_SLICER_CONFIG=
# ffmpeg para la cámara RTSP de Bambu X1/H2D
FFMPEG_BIN=
